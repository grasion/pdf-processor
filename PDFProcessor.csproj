<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>PDFProcessor.Program</StartupObject>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);.verification\**</DefaultItemExcludes>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>9040508_filetype_pdf_icon.ico</ApplicationIcon>
    <AssemblyName>PDF통합처리기</AssemblyName>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    
    <!-- 버전 정보 -->
    <Version>1.0.9</Version>
    <AssemblyVersion>1.0.9.0</AssemblyVersion>
    <FileVersion>1.0.9.0</FileVersion>
    <Company>PDF Tools</Company>
    <Product>PDF 통합 처리기</Product>
    <Copyright>Copyright © 2024</Copyright>
    <Description>PDF 분할, 병합, 이미지 변환 통합 도구</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="9040508_filetype_pdf_icon.ico" />
    <EmbeddedResource Include="9040508_filetype_pdf_icon.png" />
  </ItemGroup>

  <!-- tip.html을 임베디드 리소스로 포함 -->
  <ItemGroup>
    <EmbeddedResource Include="tip.html" />
  </ItemGroup>

  <!-- PdfiumViewer 네이티브 라이브러리를 임베디드 리소스로 포함 -->
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll">
      <LogicalName>pdfium.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
