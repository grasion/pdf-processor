<Window x:Class="PDFProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PDFProcessor"
        Title="PDF 통합 처리기"
        Height="820" Width="1280" MinHeight="680" MinWidth="1080"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <local:FileKindConverter x:Key="FileKind"/>
        <!-- 사이드바가 있는 탭 컨트롤 -->
        <Style x:Key="SidebarTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="236"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel Margin="14,18,14,14">
                                    <!-- 브랜드 -->
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                                        <Border Width="38" Height="38" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="PDF 통합 처리기" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{DynamicResource AppVersionText}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 하단: 후원 / 업데이트 / 정보 -->
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Border x:Name="CoffeeBanner" CornerRadius="10" Padding="12,10" Cursor="Hand" Margin="0,0,0,10"
                                                Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                                MouseLeftButtonDown="CoffeeBanner_Click" ToolTip="개발자 후원 QR 코드 보기">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="☕" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="개발자에게 커피 사주기" FontWeight="SemiBold" FontSize="12.5" Foreground="#9A3412"/>
                                                    <TextBlock Text="클릭하여 후원 QR 보기" FontSize="11" Foreground="#C2410C" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="업데이트 확인" Tag="&#xE895;" Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left" Click="CheckUpdate_Click"/>
                                        <Button Content="프로그램 정보" Tag="&#xE946;" Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left" Click="ShowAbout_Click"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="도구" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,8"/>
                                        <!-- StackPanel keeps the menu order fixed (TabPanel moves the selected row). -->
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 미리보기 페이지 이미지: 종이 느낌의 그림자 -->
        <Style x:Key="PaperBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 페이지 이동 알약형 툴바 -->
        <Style x:Key="PagerPill" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,12"/>
        </Style>

        <!-- 미리보기 이미지가 없을 때만 보이는 안내 (Tag에 이미지 Source를 바인딩) -->
        <Style x:Key="PreviewEmptyHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 썸네일 템플릿 -->
        <DataTemplate x:Key="SimpleThumbnailTemplate">
            <StackPanel>
                <Border Style="{StaticResource PaperBorder}">
                    <Image Source="{Binding Thumbnail}" Width="112" Height="150" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding PageLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl x:Name="MainTabControl" Style="{StaticResource SidebarTabControl}">

        <!-- ================= PDF 분할 ================= -->
        <TabItem Header="PDF 분할" Tag="&#xE8C6;">
            <Grid Margin="28,24,28,24" AllowDrop="True"
                  PreviewDragEnter="SplitDropZone_DragEnter" PreviewDragOver="SplitDropZone_DragOver" PreviewDrop="SplitDropZone_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="PDF 분할" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="페이지 범위, 개별 페이지, 일정 페이지 묶음으로 PDF를 나눕니다." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <GroupBox Header="파일">
                                <StackPanel>
                                    <Button Style="{StaticResource DropZoneButton}" Tag="&#xE898;" Click="SelectSplitFile_Click">
                                        <StackPanel>
                                            <TextBlock Text="PDF 파일 선택" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="클릭하거나 파일을 끌어다 놓으세요" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="SplitFileLabel" Text="선택된 파일: 없음" Margin="2,10,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="분할 방식">
                                <StackPanel>
                                    <RadioButton x:Name="SplitModePages" Content="페이지 범위로 분할" IsChecked="True" Checked="SplitMode_Changed"/>
                                    <RadioButton x:Name="SplitModeIndividual" Content="각 페이지를 개별 파일로 분할" Checked="SplitMode_Changed"/>
                                    <RadioButton x:Name="SplitModeChunk" Content="N페이지씩 묶어서 분할" Checked="SplitMode_Changed"/>

                                    <Grid x:Name="SplitRangePanel" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="시작 페이지" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="SplitStartPage"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="끝 페이지" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="SplitEndPage"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="SplitChunkPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock Text="묶음 단위" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="페이지씩" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox x:Name="SplitChunkSize" Text="2"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="저장 위치">
                                <StackPanel>
                                    <TextBlock x:Name="SplitOutputLabel" Text="출력 폴더: 원본 파일과 같은 폴더" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>
                                    <Button Content="출력 폴더 선택" Tag="&#xE8B7;" Click="SelectSplitOutputFolder_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="PDF 분할 실행" Tag="&#xE8C6;" Style="{StaticResource PrimaryButton}" Click="ExecuteSplit_Click" Margin="0,4,0,12"/>
                            <ProgressBar x:Name="SplitProgressBar" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SplitStatusLabel" Text="PDF 파일을 선택하세요." TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 미리보기 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="168"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.ColumnSpan="2" Margin="18,14,18,12">
                                <TextBlock Text="미리보기" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="마우스 휠로 페이지 이동" Style="{StaticResource HintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Grid.Row="1" Background="{StaticResource CanvasBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Background="Transparent" PreviewMouseWheel="SplitPreview_MouseWheel">
                                    <!-- 페이지 전체가 보이도록 영역에 맞춰 축소 -->
                                    <Viewbox Margin="24" Stretch="Uniform" StretchDirection="DownOnly">
                                        <Border Style="{StaticResource PaperBorder}">
                                            <Image x:Name="SplitPreviewImage" Stretch="None"/>
                                        </Border>
                                    </Viewbox>
                                    <TextBlock Text="PDF 파일을 선택하면 미리보기가 표시됩니다" Style="{StaticResource PreviewEmptyHint}"
                                               Tag="{Binding Source, ElementName=SplitPreviewImage}"/>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource PagerPill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Tag="&#xE76B;" Style="{StaticResource GhostButton}" ToolTip="이전 페이지" Click="SplitPrevPage_Click"/>
                                        <TextBlock x:Name="SplitPageLabel" Text="페이지: 0/0" VerticalAlignment="Center" Margin="10,0" MinWidth="80" TextAlignment="Center"/>
                                        <Button Tag="&#xE76C;" Style="{StaticResource GhostButton}" ToolTip="다음 페이지" Click="SplitNextPage_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                                    Background="{StaticResource SurfaceAltBrush}" CornerRadius="0,0,12,0">
                                <ListBox x:Name="SplitPageThumbnailList" Padding="8,10" ItemContainerStyle="{StaticResource ThumbnailItem}"
                                         ItemTemplate="{StaticResource SimpleThumbnailTemplate}"
                                         SelectionChanged="SplitPageThumbnail_SelectionChanged"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ================= PDF 병합 ================= -->
        <TabItem Header="PDF 병합" Tag="&#xE71D;">
            <Grid Margin="28,24,28,24" AllowDrop="True"
                  PreviewDragEnter="MergeDropZone_DragEnter" PreviewDragOver="MergeDropZone_DragOver" PreviewDrop="MergeDropZone_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="PDF 병합" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="PDF, 이미지, 워드, 엑셀, 파워포인트 파일을 하나의 PDF로 합치고, 페이지 회전과 용지 크기를 설정합니다." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <GroupBox Header="파일 목록">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Style="{StaticResource DropZoneButton}" Tag="&#xE898;" Click="AddMergeFiles_Click" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="PDF · 이미지 · 워드 · 엑셀 추가" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="여러 파일을 한 번에 끌어다 놓을 수 있습니다" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            <TextBlock Text="PDF · JPG · PNG · DOCX · XLSX · PPTX 등" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                                        <ListBox x:Name="MergeFileList" Height="170" SelectionChanged="MergeFileList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" CornerRadius="5" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Background="{Binding Converter={StaticResource FileKind}, ConverterParameter=soft}">
                                                            <TextBlock Text="{Binding Converter={StaticResource FileKind}, ConverterParameter=label}" FontSize="10.5"
                                                                       FontWeight="SemiBold" Foreground="{Binding Converter={StaticResource FileKind}, ConverterParameter=brush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Converter={StaticResource FileKind}}" Style="{StaticResource Icon}"
                                                                   Foreground="{Binding Converter={StaticResource FileKind}, ConverterParameter=brush}" Margin="0,0,9,0"/>
                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <UniformGrid Grid.Row="2" Columns="3" Margin="-3,8,-3,0">
                                        <Button Content="추가" Tag="&#xE710;" Click="AddMergeFiles_Click" Margin="3" Padding="6,6"/>
                                        <Button Content="위로" Tag="&#xE74A;" ToolTip="선택한 파일을 위로 이동" Click="MoveUp_Click" Margin="3" Padding="6,6"/>
                                        <Button Content="아래로" Tag="&#xE74B;" ToolTip="선택한 파일을 아래로 이동" Click="MoveDown_Click" Margin="3" Padding="6,6"/>
                                        <Button Content="제거" Tag="&#xE738;" Click="RemoveMergeFile_Click" Margin="3" Padding="6,6"/>
                                        <Button Content="전체 삭제" Tag="&#xE74D;" Click="ClearMergeFiles_Click" Margin="3" Padding="6,6"/>
                                    </UniformGrid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="저장 설정">
                                <StackPanel>
                                    <TextBlock Text="파일명" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MergeFileName" Margin="0,0,0,12"/>
                                    <TextBlock Text="저장 위치" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Tag="&#xE8B7;" ToolTip="폴더 선택" Click="BrowseMergeSavePath_Click" Margin="8,0,0,0" Padding="9,6"/>
                                        <TextBox x:Name="MergeSavePath" IsReadOnly="True"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="용지 크기" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="MergePageSize" SelectedIndex="0" SelectionChanged="MergeLayout_Changed">
                                                <ComboBoxItem Content="A4"/>
                                                <ComboBoxItem Content="A3"/>
                                                <ComboBoxItem Content="A5"/>
                                                <ComboBoxItem Content="Letter"/>
                                                <ComboBoxItem Content="Legal"/>
                                                <ComboBoxItem Content="원본"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="방향" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="MergePageOrientation" SelectedIndex="0" SelectionChanged="MergeLayout_Changed">
                                                <ComboBoxItem Content="세로"/>
                                                <ComboBoxItem Content="가로"/>
                                                <ComboBoxItem Content="원본"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="PDF 병합 실행" Tag="&#xE71D;" Style="{StaticResource PrimaryButton}" Click="ExecuteMerge_Click" Margin="0,4,0,12"/>
                            <ProgressBar x:Name="MergeProgressBar" Margin="0,0,0,8"/>
                            <TextBlock x:Name="MergeStatusLabel" Text="병합할 PDF 파일들을 추가하세요." TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 병합 미리보기 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.ColumnSpan="2" Margin="18,14,18,12">
                                <TextBlock Text="병합 미리보기" FontSize="14" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock x:Name="MergePageInfo" Text="페이지: 0 / 0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="마우스 휠로 페이지 이동" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Background="{StaticResource CanvasBrush}">
                                <ScrollViewer x:Name="MergePreviewScroll" Margin="20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="MergePreview_MouseWheel">
                                    <Image x:Name="MergePreviewImage" Stretch="Uniform"
                                           Width="{Binding ViewportWidth, ElementName=MergePreviewScroll}"
                                           Height="{Binding ViewportHeight, ElementName=MergePreviewScroll}">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#0F172A"/>
                                        </Image.Effect>
                                    </Image>
                                </ScrollViewer>
                                <TextBlock Text="파일을 추가하면 병합 결과를 미리 볼 수 있습니다" Style="{StaticResource PreviewEmptyHint}"
                                           Tag="{Binding Source, ElementName=MergePreviewImage}"/>
                            </Grid>

                            <!-- 회전 -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock x:Name="RotationModeLabel" Text="현재 페이지 회전" FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock x:Name="RotationStatusLabel" Text="" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button Content="왼쪽 90°" Tag="&#xE7A7;" Click="RotateLeft_Click" Margin="3,0" Padding="10,5"/>
                                        <Button Content="오른쪽 90°" Tag="&#xE7A6;" Click="RotateRight_Click" Margin="3,0" Padding="10,5"/>
                                        <Button Content="180°" Tag="&#xE7AD;" Click="Rotate180_Click" Margin="3,0" Padding="10,5"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 페이지 목록 -->
                            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                                    Background="{StaticResource SurfaceAltBrush}" CornerRadius="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="페이지 목록" FontWeight="SemiBold" FontSize="12.5" Margin="14,12,14,6"/>
                                    <ListBox x:Name="MergePageThumbnailList" Grid.Row="1" Padding="8,4" ItemContainerStyle="{StaticResource ThumbnailItem}"
                                             SelectionChanged="MergePageThumbnail_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Border Style="{StaticResource PaperBorder}">
                                                            <Image Source="{Binding Thumbnail}" Width="140" Height="186" Stretch="Uniform"/>
                                                        </Border>
                                                        <CheckBox Tag="{Binding PageIndex}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Checked="PageCheckBox_Changed" Unchecked="PageCheckBox_Changed"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" ToolTip="회전할 페이지로 선택"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding PageLabel}" FontSize="11.5" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding RotationInfo}" FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Grid.Row="2" Columns="2" Margin="8,6,8,10">
                                        <Button Content="전체 선택" Click="SelectAllPages_Click" Margin="3" Padding="4,6"/>
                                        <Button Content="선택 해제" Click="DeselectAllPages_Click" Margin="3" Padding="4,6"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ================= PDF → 이미지 ================= -->
        <TabItem Header="PDF → 이미지" Tag="&#xEB9F;">
            <Grid Margin="28,24,28,24" AllowDrop="True"
                  PreviewDragEnter="ConvertDropZone_DragEnter" PreviewDragOver="ConvertDropZone_DragOver" PreviewDrop="ConvertDropZone_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="PDF → 이미지" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="PDF 페이지를 PNG, JPG, BMP, TIFF 이미지로 변환합니다." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <GroupBox Header="파일">
                                <StackPanel>
                                    <Button Style="{StaticResource DropZoneButton}" Tag="&#xE898;" Click="SelectConvertFile_Click">
                                        <StackPanel>
                                            <TextBlock Text="PDF 파일 선택" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="클릭하거나 파일을 끌어다 놓으세요" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="ConvertFileLabel" Text="선택된 파일: 없음" Margin="2,10,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="변환 옵션">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="이미지 형식" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="ConvertImageFormat" SelectedIndex="0">
                                                <ComboBoxItem Content="PNG"/>
                                                <ComboBoxItem Content="JPG"/>
                                                <ComboBoxItem Content="BMP"/>
                                                <ComboBoxItem Content="TIFF"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="해상도 (DPI)" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="ConvertDPI" SelectedIndex="2">
                                                <ComboBoxItem Content="72"/>
                                                <ComboBoxItem Content="96"/>
                                                <ComboBoxItem Content="150"/>
                                                <ComboBoxItem Content="200"/>
                                                <ComboBoxItem Content="300"/>
                                                <ComboBoxItem Content="600"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="변환할 페이지" Style="{StaticResource FieldLabel}"/>
                                    <RadioButton x:Name="ConvertModeAll" Content="모든 페이지" IsChecked="True" Checked="ConvertMode_Changed"/>
                                    <RadioButton x:Name="ConvertModeRange" Content="페이지 범위 지정" Checked="ConvertMode_Changed"/>
                                    <Grid x:Name="ConvertRangePanel" Visibility="Collapsed" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="시작" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ConvertStartPage"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="끝" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ConvertEndPage"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="저장 설정">
                                <StackPanel>
                                    <TextBlock x:Name="ConvertOutputLabel" Text="출력 폴더: 원본 파일과 같은 폴더" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>
                                    <Button Content="출력 폴더 선택" Tag="&#xE8B7;" Click="SelectConvertOutputFolder_Click" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                    <TextBlock Text="파일명 패턴" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ConvertFileNamePattern"/>
                                    <TextBlock Text="{}{filename} 원본 파일명 · {page} 페이지 번호" Style="{StaticResource HintText}" Margin="2,6,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="이미지로 변환" Tag="&#xEB9F;" Style="{StaticResource PrimaryButton}" Click="ExecuteConvert_Click" Margin="0,4,0,12"/>
                            <ProgressBar x:Name="ConvertProgressBar" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ConvertStatusLabel" Text="PDF 파일을 선택하세요." TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="168"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.ColumnSpan="2" Margin="18,14,18,12">
                                <TextBlock Text="미리보기" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="마우스 휠로 페이지 이동" Style="{StaticResource HintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Grid.Row="1" Background="{StaticResource CanvasBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Background="Transparent" PreviewMouseWheel="ConvertPreview_MouseWheel">
                                    <!-- 페이지 전체가 보이도록 영역에 맞춰 축소 -->
                                    <Viewbox Margin="24" Stretch="Uniform" StretchDirection="DownOnly">
                                        <Border Style="{StaticResource PaperBorder}">
                                            <Image x:Name="ConvertPreviewImage" Stretch="None"/>
                                        </Border>
                                    </Viewbox>
                                    <TextBlock Text="PDF 파일을 선택하면 미리보기가 표시됩니다" Style="{StaticResource PreviewEmptyHint}"
                                               Tag="{Binding Source, ElementName=ConvertPreviewImage}"/>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource PagerPill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Tag="&#xE76B;" Style="{StaticResource GhostButton}" ToolTip="이전 페이지" Click="ConvertPrevPage_Click"/>
                                        <TextBlock x:Name="ConvertPageLabel" Text="페이지: 0/0" VerticalAlignment="Center" Margin="10,0" MinWidth="80" TextAlignment="Center"/>
                                        <Button Tag="&#xE76C;" Style="{StaticResource GhostButton}" ToolTip="다음 페이지" Click="ConvertNextPage_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                                    Background="{StaticResource SurfaceAltBrush}" CornerRadius="0,0,12,0">
                                <ListBox x:Name="ConvertPageThumbnailList" Padding="8,10" ItemContainerStyle="{StaticResource ThumbnailItem}"
                                         ItemTemplate="{StaticResource SimpleThumbnailTemplate}"
                                         SelectionChanged="ConvertPageThumbnail_SelectionChanged"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ================= PDF 수정 ================= -->
        <TabItem Header="PDF 수정" Tag="&#xE70F;">
            <Grid Margin="28,24,28,20" PreviewKeyDown="EditWorkspace_KeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PDF 수정" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="문장을 클릭해 바로 고칩니다. 스캔(이미지) PDF는 OCR로 글자를 인식한 뒤 수정할 수 있습니다." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 툴바 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="입력 완료" Tag="&#xE73E;" Style="{StaticResource PrimaryButton}" MinHeight="34"
                                Click="ApplyPdfEdit_Click" ToolTip="Enter" Padding="14,6" VerticalAlignment="Center"/>
                        <WrapPanel VerticalAlignment="Center">
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </WrapPanel.Resources>
                            <Button Content="열기" Tag="&#xE8E5;" Click="OpenEditPdf_Click" ToolTip="Ctrl+O"/>
                            <Button Content="저장" Tag="&#xE74E;" Click="SaveEditedPdf_Click" ToolTip="Ctrl+S"/>
                            <Border Style="{StaticResource ToolbarDivider}"/>
                            <Button x:Name="EditUndoButton" Tag="&#xE7A7;" Click="UndoPdfEdit_Click" ToolTip="되돌리기 (Ctrl+Z)" IsEnabled="False"/>
                            <Button x:Name="EditRedoButton" Tag="&#xE7A6;" Click="RedoPdfEdit_Click" ToolTip="다시 실행 (Ctrl+Y)" IsEnabled="False"/>
                            <Border Style="{StaticResource ToolbarDivider}"/>
                            <TextBlock Text="&#xE71E;" Style="{StaticResource Icon}" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,6,0"/>
                            <ComboBox x:Name="EditZoom" Width="86" SelectedIndex="1" SelectionChanged="EditZoom_Changed" ToolTip="확대">
                                <ComboBoxItem Content="75%" Tag="0.75"/>
                                <ComboBoxItem Content="100%" Tag="1"/>
                                <ComboBoxItem Content="125%" Tag="1.25"/>
                                <ComboBoxItem Content="150%" Tag="1.5"/>
                                <ComboBoxItem Content="200%" Tag="2"/>
                            </ComboBox>
                            <Border Style="{StaticResource ToolbarDivider}"/>
                            <Button Content="OCR 인식" Tag="&#xE8D2;" Click="RunOcr_Click"
                                    ToolTip="현재 페이지의 이미지에서 글자를 인식합니다 (Windows 내장 OCR)"/>
                            <CheckBox x:Name="EditAutoOcr" Content="자동 OCR" IsChecked="True" Margin="6,0,10,0" VerticalAlignment="Center"
                                      ToolTip="텍스트가 없는 페이지(스캔 문서)를 열면 자동으로 OCR을 실행합니다"/>
                            <Button Content="텍스트 복사" Tag="&#xE8C8;" Click="CopyEditText_Click"
                                    ToolTip="현재 페이지의 텍스트를 클립보드로 복사"/>
                            <Border Style="{StaticResource ToolbarDivider}"/>
                            <CheckBox Content="문장 목록" Margin="6,0" VerticalAlignment="Center"
                                      Checked="EditTextPanel_Changed" Unchecked="EditTextPanel_Changed"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- 작업 영역 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                    <DockPanel>
                        <Border x:Name="EditTextPanel" DockPanel.Dock="Right" Width="280" Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceBrush}"
                                CornerRadius="0,12,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="문장 목록" FontWeight="SemiBold" Margin="16,14,16,8"/>
                                <ListBox x:Name="EditTextList" Margin="8,0,8,8" SelectionChanged="EditTextList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12.5"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Grid AllowDrop="True" DragOver="EditDropZone_DragOver" Drop="EditDropZone_Drop">
                            <Border Background="{StaticResource CanvasBrush}" CornerRadius="12,0,0,12"/>
                            <ScrollViewer x:Name="EditPreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="EditPreview_MouseWheel">
                                <Border Margin="32" Style="{StaticResource PaperBorder}" VerticalAlignment="Top">
                                    <Canvas x:Name="EditPageCanvas" Background="White" MouseLeftButtonDown="EditPageCanvas_Click">
                                        <Image x:Name="EditPreviewImage" Stretch="Fill" IsHitTestVisible="False"/>
                                        <Canvas x:Name="EditHitLayer"/>
                                        <TextBox x:Name="EditReplacement" Style="{StaticResource InlineEditor}" Visibility="Collapsed" Panel.ZIndex="10"
                                                 TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto"
                                                 PreviewKeyDown="EditInline_KeyDown" LostKeyboardFocus="EditInline_LostFocus"/>
                                    </Canvas>
                                </Border>
                            </ScrollViewer>
                            <!-- 문서가 없을 때 -->
                            <Grid x:Name="EditEmptyState" Background="{StaticResource CanvasBrush}">
                                <Button Style="{StaticResource DropZoneButton}" Tag="&#xE8E5;" Click="OpenEditPdf_Click"
                                        Width="420" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="수정할 PDF 열기" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="클릭하거나 PDF를 여기로 끌어다 놓으세요" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                                        <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" TextAlignment="Center"
                                                   Text="원본 글꼴에 없는 글자나 더 긴 문장은 맑은 고딕으로 다시 씁니다.&#x0a;스캔한 이미지 PDF는 OCR로 자동 인식합니다."/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 상태 표시줄 -->
                <DockPanel Grid.Row="3" Margin="2,12,2,0">
                    <Border DockPanel.Dock="Right" Style="{StaticResource PagerPill}" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Tag="&#xE76B;" Style="{StaticResource GhostButton}" ToolTip="이전 페이지" Click="EditPrevPage_Click"/>
                            <TextBlock x:Name="EditPageLabel" Text="0 / 0" VerticalAlignment="Center" Margin="10,0" MinWidth="60" TextAlignment="Center"/>
                            <Button Tag="&#xE76C;" Style="{StaticResource GhostButton}" ToolTip="다음 페이지" Click="EditNextPage_Click"/>
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EditFileLabel" Text="열린 문서 없음" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EditFontLabel" Text="원본 글꼴 유지" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar x:Name="EditProgress" Width="90" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EditStatusLabel" Text="문장을 클릭해 수정 · Enter 완료 · Esc 취소 · Ctrl+S 저장"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
